# ============================================================
# TEMPLATE .env.production untuk docker compose portal-app
# Salin ke docker/.env.production (file ini GITIGNORED — jangan commit secrets!)
#   cp docker/.env.production.example docker/.env.production
# Lalu isi semua nilai <isi-...>
# ============================================================
APP_NAME=Megakomsel
APP_ENV=production
APP_KEY=<isi-php-artisan-key-generate>
APP_DEBUG=false
APP_URL=https://megakomsel.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=central_db
DB_USERNAME=portal
DB_PASSWORD=<isi-sama-dengan-MYSQL_PASSWORD-di-root-env>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail produksi: Gmail SMTP (app password). Fallback: log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=unrancreative2020@gmail.com
MAIL_PASSWORD=<isi-app-password-gmail>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=unrancreative2020@gmail.com
MAIL_FROM_NAME="megakomsel.com"

VITE_APP_NAME="${APP_NAME}"

# ── Integrasi Central ↔ Absensi (WAJIB sama dengan absensi-app) ─────────
# ABSENSI_BASE_URL: URL webhook server-to-server dari container central ke
# absensi-app (bukan domain publik) — lihat AGENTS.md deploy.
ABSENSI_BASE_URL=http://10.10.10.122:8081
# Secret harus SAMA persis dengan ABSENSI_WEBHOOK_SECRET & ABSENSI_SSO_SECRET di absensi-app .env.production
ABSENSI_WEBHOOK_SECRET=<isi-secret-sama-dengan-absensi-app>
ABSENSI_SSO_SECRET=<isi-secret-sama-dengan-absensi-app>
# Pola subdomain SSO redirect (tenant slug diganti {slug})
ABSENSI_TENANT_DOMAIN_PATTERN=https://{slug}-absensi.megakomsel.com
